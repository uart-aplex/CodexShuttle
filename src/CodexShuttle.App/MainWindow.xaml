<Window x:Class="CodexShuttle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Codex Shuttle" Height="680" Width="1180" MinHeight="480" MinWidth="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnyOperationRunning}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnyOperationRunning}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="2,3" /></DataTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F7F7F4">
        <Border DockPanel.Dock="Top" Background="#202124" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Codex Shuttle" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#EFEFEB">
            <StatusBarItem>
                <TextBlock Text="{Binding OperationStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OperationStatus}" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Background="#FFF5D6" BorderBrush="#E3BE55" BorderThickness="0,0,0,1"
                Padding="18,10" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scanning files..." FontWeight="SemiBold" Margin="0,0,14,0" />
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="10" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Large workspaces may take a moment. You can keep the app open while it checks file counts and sizes."
                           Margin="14,0,0,0" Foreground="#5F4A12" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Margin="10" Background="Transparent">
            <TabItem Header="Inspect">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="White" BorderBrush="#DDDDD8" BorderThickness="1" Padding="16" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Codex Home" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding CodexHome}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCodexHomeCommand}" Padding="10,4" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="1" Text="Process" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CodexRunningStatus}" />
                            <TextBlock Grid.Row="2" Text="Sessions" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SessionsStatus}" />
                            <TextBlock Grid.Row="3" Text="Archived" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ArchivedSessionsStatus}" />
                            <TextBlock Grid.Row="4" Text="Latest session" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LatestSessionStatus}" />
                            <TextBlock Grid.Row="5" Text="state_5.sqlite" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StateSqliteStatus}" />
                            <TextBlock Grid.Row="6" Text="session_index.jsonl" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SessionIndexStatus}" />
                            <TextBlock Grid.Row="7" Text="global/config" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="7" Grid.Column="1">
                                <Run Text="{Binding GlobalStateStatus}" />
                                <Run Text=" / " />
                                <Run Text="{Binding ConfigStatus}" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Detected Workspaces" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Workspaces}" AutoGenerateColumns="False" IsReadOnly="True"
                              MinHeight="100" MaxHeight="320"
                              CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderBrush="#DDDDD8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Exists" Binding="{Binding Exists}" Width="90" />
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="110" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                            <DataGridTextColumn Header="Latest Write" Binding="{Binding LatestWrite}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Backup">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="310" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.15*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>

                    <Border Background="White" BorderBrush="#DDDDD8" BorderThickness="1" Padding="16" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Destination" FontSize="18" FontWeight="SemiBold" />
                            <Grid Margin="0,10,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackupDestination, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseBackupDestinationCommand}" Margin="8,0,0,0" />
                            </Grid>
                            <WrapPanel>
                                <Button Content="Create Backup" Command="{Binding CreateBackupCommand}" />
                                <Button Content="Cancel Backup" Command="{Binding CancelBackupCommand}"
                                        Visibility="{Binding IsBackupRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                            <Border Background="#EAF4FF" BorderBrush="#9CC7EC" BorderThickness="1" Padding="12" Margin="0,14,0,0" CornerRadius="4"
                                    Visibility="{Binding IsBackupRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Backup is running..." FontWeight="SemiBold" />
                                    <ProgressBar IsIndeterminate="True" Height="10" Margin="0,8,0,8" />
                                    <TextBlock Text="{Binding BackupProgressStatus}" TextWrapping="Wrap" Foreground="#24435E" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,18,0,8">
                        <TextBlock Text="Included Workspaces" FontSize="18" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Add Folder..." Command="{Binding AddWorkspaceCommand}" />
                            <Button Content="Remove" Command="{Binding RemoveWorkspaceCommand}" Margin="0" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" MinHeight="100" MaxHeight="300"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderBrush="#DDDDD8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Exists" Binding="{Binding Exists}" Width="55" />
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="75" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D7DADD" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Resize settings and log" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Open Logs" Command="{Binding OpenLogsCommand}" Margin="8,0,0,0" Padding="8,4" />
                            <TextBlock Text="Backup Log" FontSize="18" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding BackupResult}" Foreground="{Binding BackupResultBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="BackupFollow" DockPanel.Dock="Bottom" Content="Auto-scroll" IsChecked="True" Margin="0,8,0,0" />
                        <ListBox x:Name="BackupLogList" ItemsSource="{Binding BackupLog}" Style="{StaticResource LogList}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Restore">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="310" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.15*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <StackPanel>

                    <Border Background="White" BorderBrush="#DDDDD8" BorderThickness="1" Padding="16" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Restore Package" FontSize="18" FontWeight="SemiBold" />
                            <Grid Margin="0,10,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RestorePackage, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseRestorePackageCommand}" Margin="8,0,0,0" />
                                <Button Grid.Column="2" Content="Load" Command="{Binding LoadRestorePackageCommand}" Margin="0" />
                            </Grid>
                            <TextBlock Text="{Binding RestorePackageInfo}" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Migration mode" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding MigrationModes}" SelectedItem="{Binding SelectedMigrationMode}"
                                          Padding="8,5" />
                                <TextBlock Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap"
                                           Text="HistoryAndTools preserves this PC's login/provider settings. FullProfile also migrates Codex configuration; credentials remain excluded." />
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="Dry Run" Command="{Binding DryRunCommand}" />
                                <Button Content="Restore" Command="{Binding RestoreCommand}" />
                                <Button Content="Repair Conversation Paths" Command="{Binding RepairConversationPathsCommand}" />
                                <Button Content="Cancel Restore" Command="{Binding CancelRestoreCommand}"
                                        Visibility="{Binding IsRestoreRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                            <Border Background="#FFF5D6" BorderBrush="#E3BE55" BorderThickness="1" Padding="12" Margin="0,14,0,0" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding DryRunSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Mirror restore makes selected destinations match the package. Destination-only files may be deleted. Credentials are never migrated."
                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#EAF4FF" BorderBrush="#9CC7EC" BorderThickness="1" Padding="12" Margin="0,12,0,0" CornerRadius="4"
                                    Visibility="{Binding IsRestoreRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Restore is running..." FontWeight="SemiBold" />
                                    <ProgressBar IsIndeterminate="True" Height="10" Margin="0,8,0,8" />
                                    <TextBlock Text="{Binding RestoreProgressStatus}" TextWrapping="Wrap" Foreground="#24435E" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,18,0,8">
                        <TextBlock Text="Fixed Workspace Restore Paths" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Workspaces are always restored to their original absolute paths so file links stored in Codex conversations remain valid."
                                   Foreground="#555" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding RestoreTargets}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="300"
                              CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderBrush="#DDDDD8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Backup source" Binding="{Binding SourcePath}" Width="1.2*" />
                            <DataGridTextColumn Header="Restore to same absolute path" Binding="{Binding TargetPath}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#D7DADD" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Resize settings and log" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Open Logs" Command="{Binding OpenLogsCommand}" Margin="8,0,0,0" Padding="8,4" />
                            <TextBlock Text="Restore Log" FontSize="18" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding RestoreResult}" Foreground="{Binding RestoreResultBrush}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="RestoreFollow" DockPanel.Dock="Bottom" Content="Auto-scroll" IsChecked="True" Margin="0,8,0,0" />
                        <ListBox x:Name="RestoreLogList" ItemsSource="{Binding RestoreLog}" Style="{StaticResource LogList}" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
