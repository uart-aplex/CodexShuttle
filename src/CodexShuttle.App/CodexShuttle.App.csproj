<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodexShuttle.Core\CodexShuttle.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.2.0</Version>
    <Product>Codex Shuttle</Product>
    <Description>Safe local backup and migration for Codex history, tools, settings, and workspaces.</Description>
  </PropertyGroup>

</Project>
